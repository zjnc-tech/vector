from typing import Any, List, Sequence, Type, TypeVar

__version__: str
MAX_BATCH_EVENTS: int
class VectorRuntimeError(RuntimeError): ...
class ClosedError(VectorRuntimeError): ...
class DeliveryError(VectorRuntimeError): ...
class QueueFullError(VectorRuntimeError): ...
_T = TypeVar("_T")
def external_event(cls: Type[_T]) -> Type[_T]: ...

class Pipeline:
    def __init__(self, yaml: str, *, worker_threads: int = ..., shutdown_timeout: float = ..., flush_timeout: float = ...) -> None: ...
    @staticmethod
    def from_yaml(yaml: str, *, worker_threads: int = ..., shutdown_timeout: float = ..., flush_timeout: float = ...) -> Pipeline: ...
    def start(self) -> Runtime: ...

class SourceHandle:
    def emit(self, event: Any) -> None: ...
    def emit_batch(self, events: Sequence[Any]) -> None: ...
    def emit_json(self, json: str) -> None: ...
    def try_emit(self, event: Any) -> None: ...
    def try_emit_batch(self, events: Sequence[Any]) -> None: ...

class Runtime:
    def source(self, name: str) -> SourceHandle: ...
    def emit(self, source: str, event: Any) -> None: ...
    def emit_batch(self, source: str, events: Sequence[Any]) -> None: ...
    def emit_json(self, source: str, json: str) -> None: ...
    def try_emit(self, source: str, event: Any) -> None: ...
    def try_emit_batch(self, source: str, events: Sequence[Any]) -> None: ...
    def flush(self) -> None: ...
    def stop(self) -> None: ...
    def close(self) -> None: ...
    @property
    def status(self) -> str: ...
    @property
    def warnings(self) -> List[str]: ...
    def __enter__(self) -> Runtime: ...
    def __exit__(self, exc_type: Any, exc: Any, tb: Any) -> bool: ...
